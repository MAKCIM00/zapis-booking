@host = http://localhost:5099

### Проверка живости
GET {{host}}/health

### Карта эндпоинтов
GET {{host}}/

### Вход демо-пользователем
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@zapis.ru",
  "password": "demo1234"
}

### Регистрация нового пользователя
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Иван Петров",
  "email": "ivan@example.com",
  "phone": "+7 913 000-00-00",
  "password": "secret123"
}

### Текущий пользователь
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

### Категории
GET {{host}}/api/categories

### Каталог услуг
GET {{host}}/api/services?page=1&pageSize=20

### Поиск по каталогу
GET {{host}}/api/services?q=массаж

### Карточка услуги
GET {{host}}/api/services/c1111111-1111-1111-1111-111111111111

### Свободные слоты на дату
GET {{host}}/api/services/c1111111-1111-1111-1111-111111111111/slots?date=2026-12-01

### Слоты конкретного мастера
GET {{host}}/api/services/c1111111-1111-1111-1111-111111111111/slots?date=2026-12-01&masterId=b1111111-1111-1111-1111-111111111111

### Создать запись
POST {{host}}/api/bookings
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "serviceId": "c1111111-1111-1111-1111-111111111111",
  "masterId": "b1111111-1111-1111-1111-111111111111",
  "startAt": "2026-12-01T03:00:00Z",
  "comment": "Первый раз"
}

### Мои предстоящие записи
GET {{host}}/api/bookings?scope=upcoming
Authorization: Bearer {{login.response.body.token}}

### История записей
GET {{host}}/api/bookings?scope=past
Authorization: Bearer {{login.response.body.token}}

### Отменить запись
POST {{host}}/api/bookings/00000000-0000-0000-0000-000000000000/cancel
Authorization: Bearer {{login.response.body.token}}

### Профиль
GET {{host}}/api/profile
Authorization: Bearer {{login.response.body.token}}

### Обновить профиль
PUT {{host}}/api/profile
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "fullName": "Демо Клиент",
  "phone": "+7 900 111-22-33"
}
